# ---- Database (local dev) ----
# Managed via `npm run db:up` / `npm run db:down` (see docker-compose.yml).
# DATABASE_URL must match the POSTGRES_* values below (host port 5434 maps to
# the container's 5432).
DATABASE_URL="postgresql://mercury:YOUR_PASSWORD@localhost:5434/mercury_landing"

POSTGRES_USER="mercury"
POSTGRES_PASSWORD="YOUR_PASSWORD"
POSTGRES_DB="mercury_landing"

# ---- Auth ----
# HMAC key used to sign the session cookie value (sessionId.signature), so a
# tampered or forged cookie is rejected before it ever reaches the DB lookup.
# Required — session creation/verification throws without it.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ---- SMTP (passwordless email sign-in) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ---- maiom-sales-engine CRM hand-off ----
# A quote request is always stored in this app's `leads` table first, then
# pushed to the sales engine. Leave CRM_API_URL empty to disable the push —
# leads are still captured locally and can be replayed later.
CRM_API_URL=""
# Shared secret; must match PUBLIC_LEAD_API_KEY on the sales-engine side.
CRM_API_KEY=""
# Override only if the intake route is mounted somewhere else.
CRM_INTAKE_PATH="/api/v1/public/leads"
CRM_TIMEOUT_MS="8000"
# Inbound direction (CRM -> FCAE): maiom-sales-engine calls POST
# /api/crm/deal-won when a Deal is marked WON, to tell FCAE that email is
# now an active client. Must match the CRM's signing secret exactly — every
# request is signed as hex(HMAC-SHA256(rawBody, WEBHOOK_SIGNING_SECRET)) in
# the `x-webhook-signature` header; requests with a missing/wrong signature
# are rejected with 401 before the body is even parsed. Leave empty to keep
# the route effectively disabled (every request fails verification).
# Deliberately a different secret from CRM_API_KEY above (that one
# authenticates FCAE -> CRM, not the reverse).
WEBHOOK_SIGNING_SECRET=""

# ---- Zoho Projects (client roadmap sync) ----
# Self-client credentials from https://api-console.zoho.in
# Required scopes: ZohoProjects.projects.READ, ZohoProjects.milestones.READ,
#                  ZohoProjects.tasks.READ
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
# Portal name as it appears in the Zoho Projects URL (e.g. "marslab")
ZOHO_PORTAL_ID=""
# Data-centre suffix: in | com | eu | com.au | jp — must match the Zoho account
ZOHO_REGION="in"

# Project custom-field label(s) holding the client's login email. A client only
# ever sees projects whose field matches their email exactly. Comma-separated
# labels; each field may itself hold several comma-separated addresses.
ZOHO_CLIENT_EMAIL_FIELD="Email,Client Email,Client_Email"

# How often Zoho is actually re-read (ms). The dashboard polls once per second,
# but those polls are served from the server's snapshot cache — this is the
# knob that decides live-ness vs. Zoho API quota consumption.
ZOHO_POLL_INTERVAL_MS="15000"
# How long the portal project list (used for email matching) is cached (ms).
ZOHO_LIST_TTL_MS="60000"

# ---- Zoho Desk (client ticket hand-off) ----
# Separate product and OAuth grant from Zoho Projects. Needs Desk.tickets.CREATE.
# Leave ZOHO_DESK_ORG_ID empty to keep the push off — tickets are still captured locally.
ZOHO_DESK_ORG_ID=""
ZOHO_DESK_CLIENT_ID=""
ZOHO_DESK_CLIENT_SECRET=""
ZOHO_DESK_REFRESH_TOKEN=""
# JSON map of taxonomy department name -> Zoho Desk numeric departmentId
ZOHO_DESK_DEPARTMENT_IDS='{"Cloud Infra":"","Dev_Ops":"","IT Infra":"","Tally Support":""}'
ZOHO_DESK_TIMEOUT_MS="10000"
